{
  "extends": "./tsconfig.base.json",
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "sdks/**/*.ts",
    "tests/**/*.mts",
    "tools/**/*.mts"
  ],
  "compilerOptions": {
