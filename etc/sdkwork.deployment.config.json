{
  "schemaVersion": 1,
  "kind": "sdkwork.deployment-index",
  "application": "sdkwork-customerservice",
  "defaultProfile": "standalone.development",
  "environments": {
    "development": {
      "applicationOrigin": "https://sdkwork-customerservice-development.sdkwork.com/",
      "cloudApiBaseUrl": "https://api-development.sdkwork.com/"
    },
    "production": {
      "applicationOrigin": "https://sdkwork-customerservice-production.sdkwork.com/",
      "cloudApiBaseUrl": "https://api-production.sdkwork.com/"
    }
  },
  "profiles": {
    "cloud.development": {
      "config": "configs\\topology\\cloud.development.env"
    },
    "cloud.production": {
      "config": "configs\\topology\\cloud.production.env"
    },
    "standalone.development": {
      "config": "configs\\topology\\standalone.development.env"
    },
    "standalone.production": {
      "config": "configs\\topology\\standalone.production.env"
    }
  }
}
